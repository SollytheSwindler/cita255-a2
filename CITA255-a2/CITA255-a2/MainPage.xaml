<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CITA255_a2.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Grid RowDefinitions ="Auto,*,Auto,Auto" ColumnDefinitions ="*,Auto" Padding="20" RowSpacing="12" ColumnSpacing="12">
                <Label Grid.Row ="0" Grid.ColumnSpan="2" Text="Game Backlog" HorizontalTextAlignment="Center" FontSize="30"/>
                <CollectionView x:Name="gameList" Grid.Row="1" Grid.Column="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" FontSize="18" Padding="10"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <CollectionView x:Name="hoursList" Grid.Row="1" Grid.Column="1">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" FontSize="18" Padding="10"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button x:Name="totalButton" Text="Calulate Total Hours" Clicked="OnTotalButtonClicked"
                        Grid.Row ="2" Grid.ColumnSpan="2" FontSize="30"/>
                <Label x:Name="totalLabel" Grid.Row ="3" Grid.ColumnSpan="2" HorizontalTextAlignment="Center" FontSize="30"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
